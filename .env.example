# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# MongoDB Atlas connection string
MONGODB_URI=

# MongoDB database name (default: magenta_insurance_demo)
MONGODB_DB=magenta_insurance_demo

# Grove gateway API key and Anthropic model
GROVE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Grove gateway base URL (defaults to the production endpoint if not set)
# ANTHROPIC_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic/v1/messages

# Flask secret key (any random string is fine for local demos)
FLASK_SECRET_KEY=change-me-in-production

# Voyage AI API key (only needed for embedder.py)
VOYAGE_API_KEY=
